[Unit]
Description=US Momentum Paper Scheduler (Yahoo Finance · NYSE)
After=network.target

[Service]
Type=simple
User=youruser
WorkingDirectory=/path/to/test-momentum-strategy
ExecStart=/path/to/venv/bin/python main.py scheduler
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
